@inject IPortfolioService PortfolioService

@if (IsOpen)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-card" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="modal-header">
                <div class="modal-title-group">
                    <span class="badge badge-purple">GET IN TOUCH</span>
                    <h3 class="modal-title">Start a Project Consultation</h3>
                    <p class="modal-subtitle">Have a distributed systems or mobile architecture project? Let's talk.</p>
                </div>
                <button class="modal-close-btn" @onclick="Close" aria-label="Close modal">
                    <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Modal Body / EditForm -->
            <div class="modal-body">
                @if (IsSubmitted)
                {
                    <div class="submission-success">
                        <div class="success-icon-wrap">
                            <svg viewBox="0 0 24 24" width="32" height="32" stroke="#34d399" stroke-width="2.5" fill="none">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                        <h4 class="success-title">Inquiry Sent Successfully!</h4>
                        <p class="success-desc">Thank you, <strong class="text-highlight">@Inquiry.FullName</strong>. Your project request has been queued. I'll get back to you within 24 hours.</p>
                        <button class="btn btn-primary mt-4" @onclick="ResetForm">Submit Another Inquiry</button>
                    </div>
                }
                else
                {
                    <EditForm Model="@Inquiry" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        <!-- Full Name -->
                        <div class="form-group">
                            <label class="form-label" for="fullName">YOUR NAME</label>
                            <InputText id="fullName" class="form-input" @bind-Value="Inquiry.FullName" placeholder="e.g. Sarah Connor" />
                            <ValidationMessage For="@(() => Inquiry.FullName)" class="validation-message" />
                        </div>

                        <!-- Email -->
                        <div class="form-group">
                            <label class="form-label" for="email">EMAIL ADDRESS</label>
                            <InputText id="email" class="form-input" @bind-Value="Inquiry.Email" placeholder="sarah@example.com" />
                            <ValidationMessage For="@(() => Inquiry.Email)" class="validation-message" />
                        </div>

                        <!-- Grid row for category and timeline -->
                        <div class="form-row-2">
                            <div class="form-group">
                                <label class="form-label" for="projectType">PROJECT SCOPE</label>
                                <InputSelect id="projectType" class="form-select" @bind-Value="Inquiry.ProjectType">
                                    <option value="Mobile Application">Mobile Application (Android/iOS)</option>
                                    <option value="Distributed Backend">Distributed Backend & Concurrency</option>
                                    <option value="Architecture Review">System Architecture Review</option>
                                    <option value="UI/UX Design System">UI/UX & Design System</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => Inquiry.ProjectType)" class="validation-message" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="timeline">ESTIMATED TIMELINE</label>
                                <InputSelect id="timeline" class="form-select" @bind-Value="Inquiry.Timeline">
                                    <option value="Immediately">Immediate (Next 2-4 weeks)</option>
                                    <option value="1-3 Months">1 - 3 Months</option>
                                    <option value="3-6 Months">3 - 6 Months</option>
                                    <option value="Advisory / Part-time">Advisory / Consultation</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => Inquiry.Timeline)" class="validation-message" />
                            </div>
                        </div>

                        <!-- Message -->
                        <div class="form-group">
                            <label class="form-label" for="message">PROJECT DETAILS</label>
                            <InputTextArea id="message" rows="4" class="form-textarea" @bind-Value="Inquiry.Message" placeholder="Describe the problem, current bottleneck, or target deliverables..." />
                            <ValidationMessage For="@(() => Inquiry.Message)" class="validation-message" />
                        </div>

                        <!-- Form Actions -->
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline" @onclick="Close" disabled="@IsLoading">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@IsLoading">
                                @if (IsLoading)
                                {
                                    <span class="spinner"></span>
                                    <span>Sending Inquiry...</span>
                                }
                                else
                                {
                                    <span>Transmit Message →</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    private ContactInquiryModel Inquiry { get; set; } = new();
    private bool IsLoading { get; set; }
    private bool IsSubmitted { get; set; }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleValidSubmit()
    {
        IsLoading = true;
        try
        {
            var success = await PortfolioService.SubmitInquiryAsync(Inquiry);
            if (success)
            {
                IsSubmitted = true;
            }
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ResetForm()
    {
        Inquiry = new();
        IsSubmitted = false;
    }
}
