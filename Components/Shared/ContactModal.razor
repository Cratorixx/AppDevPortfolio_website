@inject IPortfolioService PortfolioService

@if (IsOpen)
{
    <div class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4 transition-opacity duration-200" @onclick="Close">
        <div class="w-full max-w-lg bg-gradient-to-b from-[#111726] to-[#0c101a] border border-white/10 rounded-2xl shadow-2xl overflow-hidden relative" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="p-6 border-b border-white/[0.08] flex items-start justify-between gap-4">
                <div class="flex flex-col space-y-1">
                    <span class="inline-block w-fit px-2 py-0.5 rounded text-[10px] font-mono font-semibold tracking-wider bg-purple-950/60 border border-purple-500/30 text-purple-300 uppercase">
                        GET IN TOUCH
                    </span>
                    <h3 class="text-xl font-bold text-white tracking-tight">Start a Project Consultation</h3>
                    <p class="text-xs text-slate-400">Have a distributed systems or mobile architecture project? Let's talk.</p>
                </div>
                <button type="button" class="p-1.5 rounded-lg border border-white/10 text-slate-400 hover:text-white hover:bg-white/5 transition-colors" @onclick="Close" aria-label="Close modal">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Modal Body / EditForm -->
            <div class="p-6 max-h-[80vh] overflow-y-auto custom-scrollbar">
                @if (IsSubmitted)
                {
                    <div class="text-center py-8 px-4 flex flex-col items-center gap-3">
                        <div class="w-14 h-14 rounded-full bg-emerald-950/40 border border-emerald-500/30 flex items-center justify-center mb-2">
                            <svg class="w-7 h-7 text-emerald-400" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" fill="none">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                        <h4 class="text-lg font-bold text-white">Inquiry Sent Successfully!</h4>
                        <p class="text-xs text-slate-400 max-w-sm leading-relaxed">
                            Thank you, <strong class="text-cyan-400">@Inquiry.FullName</strong>. Your project request has been queued. I'll get back to you within 24 hours.
                        </p>
                        <button type="button" class="mt-4 px-5 py-2.5 rounded-lg bg-gradient-to-r from-purple-600 to-indigo-600 text-white text-xs font-semibold hover:from-purple-500 hover:to-indigo-500 transition-all shadow-glow-purple" @onclick="ResetForm">
                            Submit Another Inquiry
                        </button>
                    </div>
                }
                else
                {
                    <EditForm Model="@Inquiry" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        <!-- Full Name -->
                        <div class="mb-4">
                            <label class="block text-xs font-mono font-semibold text-slate-300 mb-1.5" for="fullName">YOUR NAME</label>
                            <InputText id="fullName" class="w-full px-3.5 py-2 rounded-lg bg-[#07090f] border border-white/10 text-white text-sm focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition" @bind-Value="Inquiry.FullName" placeholder="e.g. Sarah Connor" />
                            <ValidationMessage For="@(() => Inquiry.FullName)" class="text-xs text-rose-400 mt-1 block font-mono" />
                        </div>

                        <!-- Email -->
                        <div class="mb-4">
                            <label class="block text-xs font-mono font-semibold text-slate-300 mb-1.5" for="email">EMAIL ADDRESS</label>
                            <InputText id="email" class="w-full px-3.5 py-2 rounded-lg bg-[#07090f] border border-white/10 text-white text-sm focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition" @bind-Value="Inquiry.Email" placeholder="sarah@example.com" />
                            <ValidationMessage For="@(() => Inquiry.Email)" class="text-xs text-rose-400 mt-1 block font-mono" />
                        </div>

                        <!-- Grid row for category and timeline -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label class="block text-xs font-mono font-semibold text-slate-300 mb-1.5" for="projectType">PROJECT SCOPE</label>
                                <InputSelect id="projectType" class="w-full px-3.5 py-2 rounded-lg bg-[#07090f] border border-white/10 text-white text-sm focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition" @bind-Value="Inquiry.ProjectType">
                                    <option value="Mobile Application">Mobile Application (Android/iOS)</option>
                                    <option value="Distributed Backend">Distributed Backend &amp; Concurrency</option>
                                    <option value="Architecture Review">System Architecture Review</option>
                                    <option value="UI/UX Design System">UI/UX &amp; Design System</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => Inquiry.ProjectType)" class="text-xs text-rose-400 mt-1 block font-mono" />
                            </div>

                            <div>
                                <label class="block text-xs font-mono font-semibold text-slate-300 mb-1.5" for="timeline">ESTIMATED TIMELINE</label>
                                <InputSelect id="timeline" class="w-full px-3.5 py-2 rounded-lg bg-[#07090f] border border-white/10 text-white text-sm focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition" @bind-Value="Inquiry.Timeline">
                                    <option value="Immediately">Immediate (Next 2-4 weeks)</option>
                                    <option value="1-3 Months">1 - 3 Months</option>
                                    <option value="3-6 Months">3 - 6 Months</option>
                                    <option value="Advisory / Part-time">Advisory / Consultation</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => Inquiry.Timeline)" class="text-xs text-rose-400 mt-1 block font-mono" />
                            </div>
                        </div>

                        <!-- Message -->
                        <div class="mb-5">
                            <label class="block text-xs font-mono font-semibold text-slate-300 mb-1.5" for="message">PROJECT DETAILS</label>
                            <InputTextArea id="message" rows="4" class="w-full px-3.5 py-2 rounded-lg bg-[#07090f] border border-white/10 text-white text-sm focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition" @bind-Value="Inquiry.Message" placeholder="Describe the problem, current bottleneck, or target deliverables..." />
                            <ValidationMessage For="@(() => Inquiry.Message)" class="text-xs text-rose-400 mt-1 block font-mono" />
                        </div>

                        <!-- Form Actions -->
                        <div class="flex items-center justify-end gap-3 pt-3 border-t border-white/[0.08]">
                            <button type="button" class="px-4 py-2 rounded-lg border border-slate-700 text-slate-400 hover:text-white hover:border-slate-500 text-xs font-semibold transition" @onclick="Close" disabled="@IsLoading">
                                Cancel
                            </button>
                            <button type="submit" class="inline-flex items-center gap-2 px-5 py-2 rounded-lg bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-semibold shadow-glow-purple transition disabled:opacity-60" disabled="@IsLoading">
                                @if (IsLoading)
                                {
                                    <span class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                                    <span>Sending Inquiry...</span>
                                }
                                else
                                {
                                    <span>Transmit Message →</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    private ContactInquiryModel Inquiry { get; set; } = new();
    private bool IsLoading { get; set; }
    private bool IsSubmitted { get; set; }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleValidSubmit()
    {
        IsLoading = true;
        try
        {
            var success = await PortfolioService.SubmitInquiryAsync(Inquiry);
            if (success)
            {
                IsSubmitted = true;
            }
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ResetForm()
    {
        Inquiry = new();
        IsSubmitted = false;
    }
}
