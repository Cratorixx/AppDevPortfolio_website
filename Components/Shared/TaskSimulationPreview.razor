@inject IPortfolioService PortfolioService

<div class="sim-wrapper">
    <div class="sim-card">
        <!-- Terminal/App Status Header -->
        <div class="sim-header font-mono-code">
            <div class="sim-title-group">
                <span class="status-pulse-dot"></span>
                <span class="sim-title">FLOWTRACK V2.1.0</span>
            </div>
            <button class="sim-refresh-btn" @onclick="AdvanceAllTasks" title="Simulate real-time task progression">
                ↻ Tick
            </button>
        </div>

        <!-- Task List Component -->
        <div class="task-list">
            @if (Tasks != null)
            {
                @foreach (var task in Tasks)
                {
                    <div class="task-item @(ActiveUpdatingTaskId == task.Id ? "task-updating" : "")" 
                         @onclick="@(() => OnTaskClicked(task.Id))"
                         title="Click to advance task state">
                        <div class="task-meta font-mono-code">
                            <span class="dot dot-@task.ColorTheme"></span>
                            <span class="task-label">@task.Title</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-bar progress-@task.ColorTheme" style="width: @(task.ProgressPercent)%"></div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<SimulationTaskItem>? Tasks { get; set; }
    private int? ActiveUpdatingTaskId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Tasks = await PortfolioService.GetSimulationTasksAsync();
    }

    private async Task OnTaskClicked(int taskId)
    {
        ActiveUpdatingTaskId = taskId;
        await PortfolioService.RefreshSimulationTaskAsync(taskId);
        Tasks = await PortfolioService.GetSimulationTasksAsync();
        await Task.Delay(200);
        ActiveUpdatingTaskId = null;
    }

    private async Task AdvanceAllTasks()
    {
        if (Tasks == null) return;
        foreach (var task in Tasks)
        {
            await PortfolioService.RefreshSimulationTaskAsync(task.Id);
        }
        Tasks = await PortfolioService.GetSimulationTasksAsync();
    }
}
