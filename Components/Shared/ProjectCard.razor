@if (Project != null)
{
    <article class="project-card @(Project.WatermarkType == "radar" ? "theme-cyan" : "theme-purple")">
        <!-- Crosshair / Radar Watermark -->
        <div class="watermark-svg" aria-hidden="true">
            @if (Project.WatermarkType == "radar")
            {
                <svg viewBox="0 0 64 64" width="64" height="64" stroke="currentColor" fill="none" stroke-width="1">
                    <circle cx="32" cy="32" r="28" stroke-dasharray="2 3"></circle>
                    <circle cx="32" cy="32" r="16"></circle>
                    <line x1="32" y1="0" x2="32" y2="64"></line>
                    <line x1="0" y1="64" x2="64" y2="0"></line>
                </svg>
            }
            else
            {
                <svg viewBox="0 0 64 64" width="64" height="64" stroke="currentColor" fill="none" stroke-width="1">
                    <circle cx="32" cy="32" r="28" stroke-dasharray="2 3"></circle>
                    <circle cx="32" cy="32" r="16"></circle>
                    <line x1="32" y1="0" x2="32" y2="64"></line>
                    <line x1="0" y1="32" x2="64" y2="32"></line>
                </svg>
            }
        </div>

        <div class="card-main">
            <!-- Tags -->
            <div class="card-tags font-mono-code">
                @foreach (var tag in Project.Tags)
                {
                    <span class="card-tag">@tag</span>
                }
            </div>

            <!-- Title -->
            <h3 class="card-title">@Project.Title</h3>

            <!-- Description -->
            <p class="card-desc">@Project.Description</p>
        </div>

        <!-- Metric Tag Bottom -->
        <div class="card-footer">
            <span class="metric-badge font-mono-code">
                @Project.HighlightMetric
            </span>
            <div class="stars-sub font-mono-code">
                <span class="star-accent">★</span>
                <span>@Project.Stars</span>
            </div>
        </div>
    </article>
}

@code {
    [Parameter]
    public ProjectItem? Project { get; set; }
}
