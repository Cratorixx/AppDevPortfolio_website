@if (Project != null)
{
    var isCyan = Project.WatermarkType == "radar";

    <article class="relative rounded-2xl bg-[#0d121d] border border-white/[0.07] p-6 lg:p-7 flex flex-col justify-between overflow-hidden group transition-all duration-300 @(isCyan ? "hover:border-cyan-500/30 hover:shadow-[0_15px_30px_-10px_rgba(56,189,248,0.15)]" : "hover:border-purple-500/30 hover:shadow-[0_15px_30px_-10px_rgba(139,92,246,0.15)]")">
        <!-- Crosshair / Radar Watermark -->
        <div class="absolute top-6 right-6 pointer-events-none opacity-20 group-hover:opacity-35 group-hover:scale-105 transition-all duration-300 @(isCyan ? "text-cyan-400" : "text-purple-400")">
            @if (isCyan)
            {
                <svg class="w-16 h-16 stroke-1" fill="none" stroke="currentColor" viewBox="0 0 64 64">
                    <circle cx="32" cy="32" r="28" stroke-dasharray="2 3"></circle>
                    <circle cx="32" cy="32" r="16"></circle>
                    <line x1="32" x2="32" y1="0" y2="64"></line>
                    <line x1="0" x2="64" y1="32" y2="32"></line>
                </svg>
            }
            else
            {
                <svg class="w-16 h-16 stroke-1" fill="none" stroke="currentColor" viewBox="0 0 64 64">
                    <circle cx="32" cy="32" r="28" stroke-dasharray="2 3"></circle>
                    <circle cx="32" cy="32" r="16"></circle>
                    <line x1="32" x2="32" y1="0" y2="64"></line>
                    <line x1="0" x2="64" y1="32" y2="32"></line>
                </svg>
            }
        </div>

        <div>
            <!-- Tags -->
            <div class="flex items-center gap-2 mb-4 font-mono text-[10px]">
                @foreach (var tag in Project.Tags)
                {
                    <span class="px-2 py-0.5 rounded font-semibold tracking-wide uppercase @(isCyan ? "bg-cyan-950/40 border border-cyan-500/30 text-cyan-300" : "bg-purple-950/40 border border-purple-500/30 text-purple-300")">
                        @tag
                    </span>
                }
            </div>

            <!-- Title -->
            <h3 class="text-lg sm:text-xl font-bold text-white mb-2 tracking-tight transition-colors duration-200 @(isCyan ? "group-hover:text-cyan-300" : "group-hover:text-purple-300")">
                @Project.Title
            </h3>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-6">
                @Project.Description
            </p>
        </div>

        <!-- Metric Tag Bottom & Stars -->
        <div class="flex items-center justify-between mt-auto pt-2">
            <span class="inline-block px-2.5 py-1 rounded font-mono text-[11px] @(isCyan ? "bg-cyan-950/30 border border-cyan-500/30 text-cyan-400" : "bg-purple-950/30 border border-purple-500/30 text-purple-300")">
                @Project.HighlightMetric
            </span>
            <div class="flex items-center gap-1 text-xs font-mono text-slate-500">
                <span class="text-amber-400">★</span>
                <span>@Project.Stars</span>
            </div>
        </div>
    </article>
}

@code {
    [Parameter]
    public ProjectItem? Project { get; set; }
}
