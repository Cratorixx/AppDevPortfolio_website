@implements IDisposable
@inject IPortfolioService PortfolioService

<div class="rounded-2xl bg-[#0b0e17]/95 border border-slate-800/90 shadow-2xl backdrop-blur-xl p-4 sm:p-5 relative overflow-hidden" data-purpose="terminal-preview-card">
    <!-- Top Terminal Bar: Tabs & Live Clock -->
    <div class="flex items-center justify-between pb-4 border-b border-slate-800/60 font-mono text-xs flex-wrap gap-3">
        <!-- Switcher Buttons -->
        <div class="flex items-center space-x-2">
            <button type="button" class="px-2.5 py-1 rounded text-[11px] tracking-wider transition-all duration-150 @(ActiveTab == "code" ? "border border-cyan-500/40 bg-cyan-500/10 text-cyan-400 font-semibold" : "border border-slate-800 hover:border-slate-700 text-slate-400")" 
                    @onclick="@(() => SetTab("code"))">
                CODE PREVIEW
            </button>
            <button type="button" class="px-2.5 py-1 rounded text-[11px] tracking-wider transition-all duration-150 @(ActiveTab == "arch" ? "border border-purple-500/40 bg-purple-500/10 text-purple-300 font-semibold" : "border border-slate-800 hover:border-slate-700 text-slate-400")" 
                    @onclick="@(() => SetTab("arch"))">
                ARCH MAP
            </button>
            <button type="button" class="px-2.5 py-1 rounded text-[11px] tracking-wider transition-all duration-150 @(ActiveTab == "both" ? "border border-emerald-500/40 bg-emerald-500/10 text-emerald-400 font-semibold" : "border border-slate-800 hover:border-slate-700 text-slate-400")" 
                    @onclick="@(() => SetTab("both"))">
                SPLIT VIEW
            </button>
        </div>

        <!-- Live Indicator & Clock -->
        <div class="flex items-center space-x-1.5 text-slate-400 text-[11px]">
            <span class="h-1.5 w-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
            <span class="tracking-wide uppercase font-mono">LIVE · @CurrentTime</span>
        </div>
    </div>

    <!-- Upper Panel: Kotlin Code IDE Window (visible in "code" or "both") -->
    @if (ActiveTab == "code" || ActiveTab == "both")
    {
        <div class="mt-4 rounded-xl bg-[#07090f] border border-slate-800/80 p-4 font-mono text-[12px] sm:text-[13px] leading-relaxed relative overflow-hidden" data-purpose="ide-sub-window">
            <!-- Code Title Bar with macOS dots and Kotlin Tag -->
            <div class="flex items-center justify-between pb-3 mb-2 border-b border-slate-900">
                <!-- macOS Dots -->
                <div class="flex items-center space-x-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                    <span class="ml-2 text-xs text-slate-400 font-mono">TaskOrchestrator.kt</span>
                </div>
                <!-- Actions & Tag -->
                <div class="flex items-center space-x-2">
                    <button type="button" @onclick="CopyCode" class="text-[10px] text-slate-400 hover:text-white px-2 py-0.5 rounded bg-white/5 border border-white/10 transition-colors">
                        @(IsCopied ? "Copied ✓" : "Copy")
                    </button>
                    <span class="px-2 py-0.5 rounded text-[10px] bg-emerald-950/60 text-emerald-400 border border-emerald-700/40 uppercase tracking-widest font-mono">
                        Kotlin
                    </span>
                </div>
            </div>

            <!-- Syntax-Highlighted Kotlin Code Snippet -->
            <div class="space-y-0.5 overflow-x-auto select-none pt-1 custom-scrollbar">
                <div class="code-line" data-line="1">
                    <span class="text-purple-400 font-medium">class</span> <span class="text-slate-100 font-semibold">TaskOrchestrator</span> {
                </div>
                <div class="code-line" data-line="2">
                    <span class="pl-4 text-purple-400 font-medium">private val</span> <span class="text-slate-300">queue</span> =
                </div>
                <div class="code-line" data-line="3">
                    <span class="pl-8 text-cyan-300 font-medium">PriorityBlockingQueue</span>&lt;<span class="text-cyan-400">Task</span>&gt;()
                </div>
                <div class="code-line" data-line="4"> </div>
                <div class="code-line" data-line="5">
                    <span class="pl-4 text-purple-400 font-medium">fun</span> <span class="text-sky-300">dispatch</span>(task: <span class="text-cyan-400">Task</span>) {
                </div>
                <div class="code-line" data-line="6">
                    <span class="pl-8 text-slate-300">queue</span>.<span class="text-amber-300">offer</span>(task)
                </div>
                <div class="code-line" data-line="7">
                    <span class="pl-8 text-emerald-400">syncToRemote</span>(task.<span class="text-slate-300">id</span>)
                </div>
                <div class="code-line" data-line="8">
                    <span class="pl-4">}</span>
                </div>
                <div class="code-line" data-line="9"> </div>
                <div class="code-line" data-line="10">
                    <span class="pl-4 text-purple-400 font-medium">suspend fun</span> <span class="text-emerald-400">syncToRemote</span>(
                </div>
                <div class="code-line" data-line="11">
                    <span class="pl-8 text-amber-400">id</span>: <span class="text-cyan-300">UUID</span>
                </div>
                <div class="code-line" data-line="12">
                    <span class="pl-4">) =</span> <span class="text-purple-400">withContext</span>(<span class="text-sky-400">IO</span>) {
                </div>
            </div>
        </div>
    }

    <!-- Lower Panel: System Topology Architecture Node Map (visible in "arch" or "both") -->
    @if (ActiveTab == "arch" || ActiveTab == "both")
    {
        <div class="mt-4 rounded-xl bg-[#06080e] border border-slate-800/80 p-4 relative" data-purpose="topology-map">
            <!-- Topology Flow Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                @if (Nodes != null)
                {
                    @foreach (var node in Nodes)
                    {
                        <div class="p-3 rounded-lg border transition-all duration-200 cursor-pointer @GetNodeTailwindClass(node.ThemeColor, SelectedNodeId == node.Id)"
                             @onclick="@(() => SelectNode(node))">
                            <div class="text-[12px] font-semibold font-mono @GetNodeTitleColor(node.ThemeColor)">@node.Name</div>
                            <div class="text-[10px] text-slate-500 mt-0.5">@node.Subtitle</div>
                        </div>
                    }
                }
            </div>

            @if (SelectedNode != null)
            {
                <div class="mt-4 p-3.5 rounded-lg bg-[#0e1726] border border-cyan-500/40 text-xs">
                    <div class="flex items-center justify-between font-mono">
                        <span class="font-bold text-white">@SelectedNode.Name · <span class="text-cyan-400">@SelectedNode.Throughput</span></span>
                        <button type="button" class="text-slate-400 hover:text-white text-base leading-none" @onclick="@(() => SelectedNodeId = null)">×</button>
                    </div>
                    <p class="text-slate-300 text-[11px] mt-1">@SelectedNode.Description</p>
                    <div class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-[10px] text-indigo-300 mt-2">
                        <span>Stack: @SelectedNode.TechStack</span>
                        <span>Protocol: @SelectedNode.Protocol</span>
                    </div>
                </div>
            }

            <!-- Bottom Right Tag Indicator -->
            <div class="mt-4 flex justify-end">
                <span class="text-[10px] font-mono tracking-widest text-slate-500 border border-slate-800 px-2 py-0.5 rounded uppercase">
                    SYSTEM TOPOLOGY V2.1
                </span>
            </div>
        </div>
    }
</div>

@code {
    private string ActiveTab { get; set; } = "both";
    private string CurrentTime { get; set; } = DateTime.Now.ToString("HH:mm:ss");
    private Timer? _clockTimer;
    private IReadOnlyList<SystemTopologyNode>? Nodes { get; set; }
    private string? SelectedNodeId { get; set; }
    private SystemTopologyNode? SelectedNode => Nodes?.FirstOrDefault(n => n.Id == SelectedNodeId);
    private bool IsCopied { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Nodes = await PortfolioService.GetTopologyNodesAsync();

        // Reactive Timer for terminal live clock
        _clockTimer = new Timer(async _ =>
        {
            CurrentTime = DateTime.Now.ToString("HH:mm:ss");
            await InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;
    }

    private void SelectNode(SystemTopologyNode node)
    {
        SelectedNodeId = SelectedNodeId == node.Id ? null : node.Id;
    }

    private string GetNodeTailwindClass(string theme, bool isSelected)
    {
        var borderAndBg = theme switch
        {
            "purple" => "bg-[#140e24]/80 border-purple-900/40 hover:border-purple-500/50",
            "cyan" => "bg-[#0e1724]/80 border-cyan-900/40 hover:border-cyan-500/50",
            "teal" => "bg-[#0f1821]/80 border-slate-800 hover:border-slate-700",
            "emerald" => "bg-[#0c161d]/80 border-teal-900/40 hover:border-teal-500/50",
            "amber" => "bg-[#1c130d]/80 border-amber-900/40 hover:border-amber-500/50",
            _ => "bg-[#0e1322]/80 border-blue-900/40 hover:border-blue-500/50"
        };

        if (isSelected)
        {
            borderAndBg += " ring-1 ring-cyan-400 border-cyan-400 shadow-glow-cyan";
        }

        return borderAndBg;
    }

    private string GetNodeTitleColor(string theme) => theme switch
    {
        "purple" => "text-purple-300",
        "cyan" => "text-cyan-300",
        "teal" => "text-slate-300",
        "emerald" => "text-teal-300",
        "amber" => "text-amber-300",
        _ => "text-blue-300"
    };

    private async Task CopyCode()
    {
        IsCopied = true;
        await Task.Delay(2000);
        IsCopied = false;
    }

    public void Dispose()
    {
        _clockTimer?.Dispose();
    }
}
