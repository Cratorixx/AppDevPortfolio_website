@inject NavigationManager Navigation

@if (Project != null)
{
    <article class="relative rounded-2xl bg-gradient-to-b from-[#111726]/80 to-[#0c101a]/95 border border-white/[0.08] p-6 lg:p-8 shadow-2xl mb-6 overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <!-- Left Column: App UI Simulation Preview -->
            <div class="lg:col-span-5 flex justify-center w-full">
                <TaskSimulationPreview />
            </div>

            <!-- Right Column: Project Details -->
            <div class="lg:col-span-7 flex flex-col justify-center">
                <!-- Tags Row -->
                <div class="flex flex-wrap items-center gap-2 mb-3 font-mono text-[11px]">
                    @foreach (var tag in Project.Tags)
                    {
                        <span class="px-2 py-0.5 rounded bg-purple-950/60 border border-purple-500/30 text-purple-300 font-semibold uppercase">@tag</span>
                    }
                </div>

                <!-- Project Title -->
                <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-3">
                    @Project.Title
                </h2>

                <!-- Description -->
                <p class="text-sm sm:text-base text-slate-400 leading-relaxed mb-4">
                    @Project.Description
                </p>

                <!-- Highlight Metric Pill -->
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-purple-500/30 bg-purple-950/20 text-purple-300 font-mono text-xs w-fit mb-5">
                    <span class="text-purple-400">★</span>
                    <span class="font-medium">@Project.HighlightMetric</span>
                </div>

                <!-- Architecture Footnote -->
                <div class="font-mono text-[11px] text-slate-500 uppercase tracking-wider mb-4">
                    @Project.ArchitectureFootnote
                </div>

                <!-- Stars & Commits Metrics -->
                <div class="flex items-center gap-4 text-xs font-mono text-amber-300/90 mb-6">
                    <div class="flex items-center gap-1.5">
                        <span class="text-amber-400">★</span>
                        <span class="text-slate-300">@Project.Stars</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-slate-400">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="18" cy="18" r="3"></circle>
                            <circle cx="6" cy="6" r="3"></circle>
                            <path d="M18 9a9 9 0 0 1-9 9"></path>
                        </svg>
                        <span>@Project.Commits commits</span>
                    </div>
                </div>

                <!-- Call to Action Buttons -->
                <div class="flex flex-wrap items-center gap-3">
                    <button type="button" @onclick="GoToDeepDive" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#7042f8] hover:bg-[#6032e8] text-white text-xs font-semibold shadow-lg shadow-purple-900/30 transition-all duration-200">
                        <svg class="w-3.5 h-3.5 stroke-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                        <span>System Deep Dive</span>
                    </button>

                    <a class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#0e1422] hover:bg-[#131b2e] border border-white/10 text-white text-xs font-semibold transition-all duration-200" href="@(Project.SourceUrl ?? "https://github.com/Cratorixx")" target="_blank" rel="noopener noreferrer">
                        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                            <path clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" fill-rule="evenodd"></path>
                        </svg>
                        <span>Source Code</span>
                    </a>
                </div>
            </div>
        </div>
    </article>
}

@code {
    [Parameter]
    public ProjectItem? Project { get; set; }

    private void GoToDeepDive()
    {
        Navigation.NavigateTo("architecture");
    }
}
