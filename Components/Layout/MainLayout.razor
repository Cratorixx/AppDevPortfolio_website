@inherits LayoutComponentBase

<div class="min-h-screen text-slate-200 antialiased relative hero-glow-bg flex flex-col justify-between overflow-x-hidden selection:bg-purple-600 selection:text-white">
    <NavBar OnOpenContact="OpenContact" OnResumeRequested="HandleResumeRequest" />

    <main class="flex-1 w-full">
        @Body
    </main>

    <Footer />

    <ContactModal @bind-IsOpen="IsContactModalOpen" />

    @if (ShowResumeToast)
    {
        <div class="fixed bottom-6 right-6 z-50 bg-[#0c101a] border border-emerald-500/40 rounded-xl p-4 shadow-2xl flex items-center justify-between gap-5 transition-all duration-300 cursor-pointer animate-fade-in" @onclick="DismissToast">
            <div class="flex items-center space-x-3 text-sm text-white">
                <svg class="w-5 h-5 text-emerald-400 shrink-0" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none">
                    <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                <div>
                    <strong class="font-semibold block text-slate-100">Resume Download Initiated</strong>
                    <span class="text-xs text-slate-400 font-mono">Generating verified PDF transcript for AK...</span>
                </div>
            </div>
            <button type="button" class="text-slate-500 hover:text-white text-lg leading-none transition-colors" @onclick="DismissToast">×</button>
        </div>
    }
</div>

@code {
    private bool IsContactModalOpen { get; set; }
    private bool ShowResumeToast { get; set; }

    private void OpenContact()
    {
        IsContactModalOpen = true;
    }

    private async Task HandleResumeRequest()
    {
        ShowResumeToast = true;
        await Task.Delay(3500);
        ShowResumeToast = false;
        await InvokeAsync(StateHasChanged);
    }

    private void DismissToast()
    {
        ShowResumeToast = false;
    }
}
